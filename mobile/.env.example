# Copy to .env.local. Expo auto-loads EXPO_PUBLIC_* vars into the client bundle.
# These mirror the web app's VITE_SUPABASE_* values (same Supabase project).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SITE_URL=https://worldly.app
EXPO_PUBLIC_MONETIZATION_ENABLED=false
# EXPO_PUBLIC_SENTRY_DSN=
