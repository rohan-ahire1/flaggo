# Flaggo environment variables
# Copy to .env.local for local dev, and set the same in Netlify for prod.
# Client vars (VITE_*) are exposed to the browser — never put secrets here.

# --- Supabase (client) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Stripe (client) ---
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Ads / analytics / errors (client) ---
VITE_ADSENSE_CLIENT_ID=
VITE_PLAUSIBLE_DOMAIN=
VITE_SENTRY_DSN=
VITE_SITE_URL=http://localhost:5173
# Keep ads OFF until AdSense approves the live site:
VITE_ADS_ENABLED=false

# --- Server-only (Netlify Functions) — NEVER prefix with VITE_, never commit real values ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
